# Copy to .env.local and fill in locally. Never commit real credentials.
# Generate a random secret of at least 32 characters (see README).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Canonical application origin; use the actual HTTPS origin when deployed.
AUTH_URL=http://localhost:3000

# Trusted server-side Stellar RPC. The reported network MUST be Testnet.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Never put these secrets in NEXT_PUBLIC_* variables.
